      "parameters": {
        "language": "javaScript",
        "jsCode": "// Parse pur de la reponse HTTP Volume Gate.\n// Aucune variable d'environnement, aucun fetch — uniquement input + node refs.\nconst weekId = $node['Code: compute_week_id'].json.week_id;\nconst resp = $input.first().json;\nconst headers = resp && resp.headers ? resp.headers : {};\nconst countHeader = headers['content-range'] || headers['Content-Range'] || '0/0';\nconst count = parseInt(String(countHeader).split('/').pop() || '0', 10);\nconst sufficient = count >= 10;\nreturn [{ json: { week_id: weekId, clean_posts_count: count, sufficient } }];\n",
        "notes": "Parse pur (sans $env, sans fetch). Lit content-range exposé par HTTP Volume Gate (fullResponse=true) et calcule sufficient = count >= 10."
      },
