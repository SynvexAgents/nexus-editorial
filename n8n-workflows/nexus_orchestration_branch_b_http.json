      "parameters": {
        "language": "javaScript",
        "jsCode": "// Calcule la week_id ISO 8601 de la semaine courante (Europe/Paris).\n// Source de vérité pour toute la branche.\nconst now = new Date();\nconst utc = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\nconst dayNum = utc.getUTCDay() || 7;\nutc.setUTCDate(utc.getUTCDate() + 4 - dayNum);\nconst yearStart = new Date(Date.UTC(utc.getUTCFullYear(), 0, 1));\nconst week = Math.ceil(((utc.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);\nconst weekId = `${utc.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;\nconst monday = new Date(utc);\nmonday.setUTCDate(utc.getUTCDate() - 3);\nmonday.setUTCHours(0, 0, 0, 0);\nreturn [{ json: { week_id: weekId, week_start_iso: monday.toISOString() } }];\n",
        "notes": "Source de vérité week_id. Propagé via $node['Code: compute_week_id'].json.week_id."
      },
      "id": "code_week_id",
      "name": "Code: compute_week_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
