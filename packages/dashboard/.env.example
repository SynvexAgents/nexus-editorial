# Variables d'environnement Nexus Editorial dashboard.
# Copier en .env.local pour le dev local. Côté Lovable, configurer
# via l'UI projet (Settings → Environment Variables).

# URL Supabase du projet (jugcyqtweavrltmxdogg).
VITE_SUPABASE_URL=https://jugcyqtweavrltmxdogg.supabase.co

# Clé anon (publique, RLS appliquée côté serveur). NE PAS coller le
# service_role_key ici — il ne doit jamais arriver dans un bundle
# front public.
VITE_SUPABASE_ANON_KEY=<copier depuis Supabase Dashboard → API Settings>
